<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (Android 8+). aapt2 compiles this file directly in
     tools/build-apk.ps1; AGP's resource merger cannot be used on this machine
     because the endpoint security agent encrypts java.exe writes. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
