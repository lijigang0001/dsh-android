<?xml version="1.0" encoding="utf-8"?>
<!-- The bundled DSH server binds 127.0.0.1 and speaks plain HTTP. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
